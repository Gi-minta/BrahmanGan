<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Assembly de migraciones EF Core para SQL Server.
    Las migraciones son específicas de cada proveedor y no son portables; por eso
    viven en su propio proyecto. El proveedor activo (Database:Provider) determina
    en runtime cuál se usa (ver DatabaseProviderResolver / MigrationsAssemblies).

    Regenerar / añadir migraciones para SQL Server:
      dotnet ef migrations add <Nombre> \
        --project BrahmanGan.Infrastructure.Migrations.SqlServer \
        --startup-project BrahmanGan.API
      (con Database:Provider=SqlServer)
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrahmanGan.Infrastructure\BrahmanGan.Infrastructure.csproj" />
  </ItemGroup>

</Project>
